{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Games Recap",
    "description": "Reads game-score threads and posts weekly recaps",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "Games Recap",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "users:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
